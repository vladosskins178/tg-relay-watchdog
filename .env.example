# Copy to .env and fill in. Never commit .env.
TG_BOT_TOKEN=123456789:replace-with-your-bot-token
# Comma-separated chat ids allowed to drive the session (get yours from @userinfobot)
TG_ALLOWED_CHAT_IDS=111111111
# tmux target: session, or session:window.pane
TMUX_TARGET=main
# Optional: command to (re)start the tmux session if it is missing, e.g. your CLI
TMUX_START_CMD=
# Optional
TG_RELAY_STATE_DIR=
TG_POLL_TIMEOUT=25
TG_SKIP_BACKLOG=0
TG_RELAY_SERVICE=tg-relay
